# Generated by gvm. Do NOT edit this file directly.
# gvm owns: /etc/gvm/caddy/Caddyfile
# gvm NEVER writes /etc/caddy/Caddyfile (D-37).

{
	admin unix//run/caddy/admin.sock|0660 {
		enforce_origin
	}
	email ops@example.com
	servers {
		timeouts {
			read_header 10s
			idle 10m
		}
		protocols h1 h2 h3
	}
}

gvm.example.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# text/* is NOT in this list on purpose: it matches text/event-stream,
	# and the live console must not depend on the encoder's flush behaviour
	# (D-38).
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# /stream/ and /api/v1/stream/ are reserved by gvm for Server-Sent
	# Events and nothing else, so these matchers can never drift as the
	# app grows routes (D-38).
	handle /stream/* {
		reverse_proxy unix//run/gvm/web/dashboard.sock {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	handle /api/v1/stream/* {
		reverse_proxy unix//run/gvm/web/dashboard.sock {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	handle {
		reverse_proxy unix//run/gvm/web/dashboard.sock
	}

	log {
		output file /var/log/caddy/gvm.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
