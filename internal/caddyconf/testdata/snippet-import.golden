# Managed by gvm (edge.mode: caddy_snippet). Do NOT edit this file directly.
# gvm never touches caddy.service in this mode. Import this site from the
# system Caddyfile:
#     import /etc/gvm/caddy/gvm.caddyfile
# or drop it into a sites directory the Caddyfile already imports
# (e.g. /etc/caddy/sites.d with `import sites.d/*.caddy`).

gvm.example.com {
	# text/* is NOT in this list on purpose: it matches text/event-stream,
	# and the live console must not depend on the encoder's flush behaviour
	# (D-38).
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# /stream/ and /api/v1/stream/ are reserved by gvm for Server-Sent
	# Events and nothing else, so these matchers can never drift as the
	# app grows routes (D-38).
	handle /stream/* {
		reverse_proxy 127.0.0.1:8130 {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	handle /api/v1/stream/* {
		reverse_proxy 127.0.0.1:8130 {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8130
	}
}
