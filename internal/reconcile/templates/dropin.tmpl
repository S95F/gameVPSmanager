{{- /*
The generated 10-gvm.conf (ARCHITECTURE.md 7.4).

Every conditional here is a fact about ONE instance that the package-owned
gvm@.service cannot know: which account, which paths, whether the world lives
under /home, whether the engine is 32-bit, whether the runtime JITs. Anything
true for the whole box belongs in the template, not here -- a directive that
appeared in both would be a supervision policy with two owners.

The comments are not decoration. This file is what an operator reads when
`systemctl cat` surprises them and what a future security pass reads before
"hardening" MemoryDenyWriteExecute, so each explains a decision that looks
wrong until you know why.
*/ -}}
# GENERATED BY `gvm apply` -- DO NOT EDIT.
# source      {{ .SpecPath }}
# spec sha256 {{ .SpecSHA }}
# manifest    {{ .Game }} rev {{ .Revision }} sha256:{{ .ManifestSHA }} (origin: {{ .Origin }})
# rendered    {{ .Rendered }} by gvm {{ .Version }}
# Operator overrides go in 90-local.conf, which gvm never writes, reads or deletes.

[Service]
User={{ .User }}
Group={{ .Group }}
UMask={{ .UMask }}
{{- if .Adopted }}
# Adopted: this account pre-dates gvm and may own other objects on the box, so
# the template's RemoveIPC=yes -- which clears the account's IPC objects at
# stop -- is turned off here.
RemoveIPC=no
{{- end }}

WorkingDirectory={{ .WorkingDir }}
{{- range .Env }}
Environment={{ .Key }}={{ .Value }}
{{- end }}
{{- range .CredEnv }}
# runtime.env.{{ . }} expands a secret and is deliberately NOT written here:
# Environment= is readable through `systemctl show` and /proc/<pid>/environ, so
# a password in it is a password published. The runner passes it to the game
# from CREDENTIALS_DIRECTORY instead (D-02).
{{- end }}
{{ range .Sandbox.HomeReason }}
# {{ . }}
{{- end }}
# `gvm apply` write-probed every path below inside a transient unit carrying
# these exact properties before writing this file (D-15).
ProtectHome={{ .Sandbox.ProtectHome }}
ReadWritePaths={{ .PathsLine }}
{{- if .Creds }}
{{ range .Creds }}
LoadCredential={{ .ID }}:{{ .Path }}
{{- end }}
{{- end }}
{{- if .MissingLine }}

# {{ .MissingLine }}
# systemd fails a unit outright when LoadCredential= names a file that is not
# there, so the line is omitted rather than written against a path that does
# not exist yet. `gvm run`'s preflight reports every absent credential by name.
{{- end }}
{{ range .SizeNote }}
# {{ . }}
{{- end }}
MemoryHigh={{ .Resources.MemoryHigh }}
MemoryMax={{ .Resources.MemoryMax }}
# A swapped server is a dead server long before it is an OOM: throughput
# collapses while the process is still alive, which is far harder to diagnose
# than a restart.
MemorySwapMax={{ .Resources.MemorySwapMax }}
CPUWeight={{ .Resources.CPUWeight }}
IOWeight={{ .Resources.IOWeight }}
TasksMax={{ .Resources.TasksMax }}
LimitNOFILE={{ .Resources.NoFile }}
{{ range .ArchNote }}
# {{ . }}
{{- end }}
{{- if .Arch }}
SystemCallArchitectures={{ .Arch }}
{{- end }}
{{ range .MDWENote }}
# {{ . }}
{{- end }}
MemoryDenyWriteExecute={{ .MDWE }}

# {{ .TimeoutNote }}
TimeoutStartSec={{ .TimeoutStart }}
TimeoutStopSec={{ .TimeoutStop }}
{{- if .EgressLines }}

# spec.egress.policy=allowlist: deny all outbound then re-admit each allowed
# CIDR. systemd wires this through the cgroup-BPF address filter (section 18.4).
# Use CIDRs, not hostnames: systemd resolves hostnames once at unit start and
# caches the result; a backend that rotates its IP between restarts would
# break silently.
{{- range .EgressLines }}
{{ . }}
{{- end }}
{{- end }}
