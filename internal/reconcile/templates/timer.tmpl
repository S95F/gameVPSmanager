{{- /*
One job's generated timer (ARCHITECTURE.md 7.5).

The trigger is systemd and the ledger is Postgres, never the reverse: the
nightly backup has to fire when gvmd, gvm-web and the database are all dead
(D-29). That is why this file exists at all rather than a row in a table and a
scheduler goroutine.
*/ -}}
# GENERATED BY `gvm apply` -- DO NOT EDIT.
# unit        {{ .Unit }}
# source      {{ .SpecPath }}
# spec sha256 {{ .SpecSHA }}
# rendered    {{ .Rendered }} by gvm {{ .Version }}
# Edit the instance file above and re-run `gvm apply`.

[Unit]
Description={{ .Description }}

[Timer]
Unit={{ .Service }}
OnCalendar={{ .OnCalendar }}
RandomizedDelaySec={{ .RandomizedDelaySec }}
{{- range .PersistentNote }}
# {{ . }}
{{- end }}
Persistent={{ .Persistent }}
# One minute is far tighter than a nightly restart needs and far looser than
# the default timer slack on a busy box, which systemd widens to a full minute
# anyway once several timers share an elapse.
AccuracySec=1min

[Install]
WantedBy=timers.target
