# Edit the instance file above and re-run `gvm apply`.

[Unit]
Description=gvm update for pz-main (job nightly)

[Timer]
Unit=gvm-job@pz-main_nightly.service
OnCalendar=*-*-* 05:00:00 America/Denver
RandomizedDelaySec=120
# false, exactly like zomboid-restart.timer: a missed restart must NOT fire
# the moment the box boots, mid-day, with players on.
Persistent=false
# One minute is far tighter than a nightly restart needs and far looser than
# the default timer slack on a busy box, which systemd widens to a full minute
# anyway once several timers share an elapse.
AccuracySec=1min

[Install]
WantedBy=timers.target
