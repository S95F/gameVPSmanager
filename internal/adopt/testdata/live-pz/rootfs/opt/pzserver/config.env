# Project Zomboid dedicated server - configuration
# Fixture for gvm adopt tests. Contains intentional security issues.

# ---- System ----
PZ_USER=pzserver
INSTALL_DIR=/opt/pzserver
DATA_DIR=/home/pzserver/Zomboid
STEAMCMD_DIR=/opt/steamcmd

# ---- Server identity ----
SERVER_NAME=servertest
PUBLIC_NAME="MadGaymers.club"
PUBLIC=true

# ---- Ports ----
GAME_PORT=16261
UDP_PORT=16262
RCON_PORT=27015
RCON_PASSWORD=""

# ---- JVM memory ----
JVM_XMX=5g
JVM_XMS=2g

# ADOPT-003 trigger: cleartext password in config.env
SERVER_PASSWORD="HunterTwo!"

# ADOPT-NeverExecutes: command substitution must be returned as a literal string
DANGEROUS_KEY=$(rm -rf /)
BACKTICK_KEY=`echo hacked`
INTERP_KEY=${DANGEROUS_KEY}
