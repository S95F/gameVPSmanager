# Build output
/bin/
/dist/
gvm
gvm.exe
gvmd
gvmd.exe
*.test

# Go
/vendor/
coverage.out
coverage.html

# Local state — never commit
*.env
# No negation for the vendored copy: it is config.env.example precisely so
# that a real config.env can never be un-ignored back into a commit.
config.local.*
/data/
/run/
secrets.key
*.pem
*.key
!**/*.go

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
