# =============================================================
# Project Zomboid dedicated server - configuration
# Tuned for an 8GB VPS running the 18-mod B42 list.
# =============================================================

# ---- System ----
PZ_USER=pzserver
INSTALL_DIR=/opt/pzserver
DATA_DIR=/home/pzserver/Zomboid
STEAMCMD_DIR=/opt/steamcmd

# ---- Mod list source ----
# The Steam collection rebuild.sh pulls mods.txt from.
COLLECTION_ID=3795231359

# ---- Server identity ----
SERVER_NAME=servertest
PUBLIC_NAME="MadGaymers.club"
PUBLIC_DESC="Modded Build 42 - vehicles, QoL, no PvP"
PUBLIC=true
OPEN=true                            # false = whitelist only (see notes below)
SERVER_PASSWORD="REDACTED-see-the-live-server-config.env"  # scrubbed when vendored into this repo
MAX_PLAYERS=8                        # realistic ceiling for 8GB with this mod list
PVP=false
PAUSE_EMPTY=true                     # frees the CPU entirely when nobody is on

# ---- Difficulty ----
# Empty = leave the server's generated settings alone (B42's default equals
# the "apocalypse" preset). Otherwise one of the presets the server ships:
#   outbreak        easier: more loot/skill books, utilities last longer
#   apocalypse      the B42 standard (what you get today)
#   rising          sparse zombies at first, but loot-starved
#   extinction      hardest: high population, loot slashed
#   sixmonthslater  late-apocalypse scenario start
# Per-key tweaks on top go in sandbox.txt. Population/loot changes apply on
# any restart cycle; world-generation keys (start date etc.) need a full
# ./rebuild.sh to matter.
SANDBOX_PRESET=""

# ---- Admin ----
ADMIN_PASSWORD=""                    # empty = generated and printed at the end

# ---- Ports ----
GAME_PORT=16261
UDP_PORT=16262
RCON_PORT=27015
RCON_PASSWORD=""

# ---- JVM memory ----
# 8GB total. B42 uses significant native memory OUTSIDE the Java heap during
# world streaming, so the heap must leave ~3GB free or the kernel OOM-kills the
# JVM mid-generation. 5g is the ceiling here, not a conservative starting point.
JVM_XMX=5g
JVM_XMS=2g

# ---- Firewall ----
SSH_PORT=""                          # auto-detected from your live session
ADMIN_IP=""                          # set to your home IP to reach RCON directly
INSTALL_FAIL2BAN=true

# ---- Maintenance ----
# Nightly restart matters more on a small box: heap pressure accumulates faster
# when the heap is tight, and a restart clears it before players notice GC stutter.
RESTART_DAILY=true
RESTART_TIME="05:00"
# Timezone for RESTART_TIME (IANA name). Empty = the server's own clock (UTC
# on this VPS). America/Denver = 5am Mountain wall-clock year-round, DST
# handled; use America/Phoenix instead for fixed MST with no DST shift.
RESTART_TZ="America/Denver"
# true = the nightly cycle runs the full update.sh instead of a plain restart:
# backup, Steam binary update, workshop refresh on boot, mod-ID re-sync. Adds a
# few minutes of downtime at RESTART_TIME; if the Steam download fails the
# server still comes back up on the existing binaries. Apply changes to these
# three settings with:  sudo ./nightly.sh
UPDATE_ON_RESTART=true
BACKUP_DIR=/var/backups/pzserver
BACKUP_KEEP=14
